        <mxCell id="2eJa07rHfNJtS575VV4D-38" edge="1" parent="1" source="2eJa07rHfNJtS575VV4D-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.442;entryY=0.004;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=12;startSize=8;endSize=8;align=left;" target="2eJa07rHfNJtS575VV4D-36">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2eJa07rHfNJtS575VV4D-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;h3 data-section-id=&quot;19we7iz&quot; data-start=&quot;26&quot; data-end=&quot;53&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;A &lt;strong data-start=&quot;57&quot; data-end=&quot;73&quot;&gt;Docker Image&lt;/strong&gt; is a &lt;strong data-start=&quot;79&quot; data-end=&quot;109&quot;&gt;read-only template/package&lt;/strong&gt; that contains everything required to run an application, such as:&lt;br&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="80" width="450" x="50" y="2040" as="geometry" />
        </mxCell>
        <mxCell id="2eJa07rHfNJtS575VV4D-42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;h3 data-section-id=&quot;19we7iz&quot; data-start=&quot;26&quot; data-end=&quot;53&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;A &lt;strong data-start=&quot;371&quot; data-end=&quot;391&quot;&gt;Docker Container&lt;/strong&gt; is a &lt;strong data-start=&quot;397&quot; data-end=&quot;435&quot;&gt;running instance of a Docker image&lt;/strong&gt;.&lt;/h3&gt;" vertex="1">
          <mxGeometry height="50" width="450" x="50" y="2140" as="geometry" />
        </mxCell>
        <mxCell id="2eJa07rHfNJtS575VV4D-43" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="Image&lt;div&gt;&amp;lt;Image name&amp;gt;:&amp;lt;tag&amp;gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="260" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="2eJa07rHfNJtS575VV4D-44" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Command&lt;/th&gt;&lt;th&gt;What it does&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Checks whether Docker CLI is available and shows basic information/help.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker --help&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Displays available Docker commands and options.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker version&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Shows detailed Docker client and server version information.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker --version&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Shows only the Docker CLI version.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker run --help&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Shows all available options for the &lt;code&gt;docker run&lt;/code&gt; command.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker pull nginx&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Downloads the &lt;strong&gt;Nginx image&lt;/strong&gt; from a Docker registry, usually Docker Hub.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker images&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Lists all Docker images available locally.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker run nginx&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Creates and starts a container from the &lt;code&gt;nginx&lt;/code&gt; image.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker run --name ranjan nginx:latest&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Creates a container with a custom name &lt;code&gt;ranjan&lt;/code&gt; using the &lt;code&gt;nginx:latest&lt;/code&gt; image.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker ps&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Shows currently &lt;strong&gt;running containers&lt;/strong&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker ps -a&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Shows &lt;strong&gt;all containers&lt;/strong&gt;, including stopped containers.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker start &amp;lt;container&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Starts an existing stopped container.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker stop &amp;lt;container&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Stops a running container.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker rm &amp;lt;container&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Removes a stopped container.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker rm &amp;lt;container&amp;gt; --force&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Forcefully removes a container, even if it is running.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker rmi &amp;lt;image&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Removes a Docker image from the local system.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker rmi &amp;lt;image&amp;gt; --force&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Forcefully removes a Docker image.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker run ubuntu&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Creates and runs a container from the Ubuntu image.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker run &amp;lt;image-id&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Creates a container using an image ID.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker run -d &amp;lt;image&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Runs the container in &lt;strong&gt;detached/background mode&lt;/strong&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker run -d -p 8080:80 nginx:latest&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Runs Nginx in the background and maps &lt;strong&gt;host port 8080 → container port 80&lt;/strong&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker exec -it &amp;lt;container&amp;gt; bash&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Opens an &lt;strong&gt;interactive Bash shell inside a running container&lt;/strong&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker exec -it &amp;lt;container&amp;gt; ls&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Executes &lt;code&gt;ls&lt;/code&gt; inside the running container.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker exec -it &amp;lt;container&amp;gt; pwd&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Shows the current directory inside the container.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker exec -it &amp;lt;container&amp;gt; whoami&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Shows the current user inside the container.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker search nginx&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Searches Docker Hub for Nginx images.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker search python&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Searches Docker Hub for Python images.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;docker logs &amp;lt;container&amp;gt;&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Displays logs generated by a container.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="540" width="730" x="40" y="2300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
